DJANGO_SECRET_KEY=change-this-before-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Default: SQLite, no extra database service needed.
DB_ENGINE=sqlite
SQLITE_NAME=db.sqlite3

# Optional MySQL settings. Uncomment and install mysqlclient when needed.
# DB_ENGINE=mysql
# DB_NAME=market
# DB_USER=root
# DB_PASSWORD=your-password
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Optional QQ email verification. Without these values, verification codes are
# printed to the development console and also shown on the page.
# EMAIL_HOST=smtp.qq.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your@qq.com
# EMAIL_HOST_PASSWORD=your-qq-authorization-code
# DEFAULT_FROM_EMAIL=your@qq.com
